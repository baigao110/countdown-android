<?xml version="1.0" encoding="utf-8"?>
<!-- 意见反馈页：与「关于」页同一套液态玻璃风格（深色渐变底 + 模糊光斑 + 玻璃卡片 + 青色胶囊按钮）。
     输入项用 field_bg 底板（和「添加倒计时」页一致），开关用 GlassSwitch，按钮一律 circle_btn。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/glass_bg">

    <com.baigao.countdown.GlassBackdrop
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 顶部返回栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:id="@+id/backBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="‹ 返回"
            android:textColor="#00FFFF"
            android:textSize="16sp"
            android:padding="4dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="意见反馈"
            android:textColor="#00FFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginEnd="40dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="60dp"
            android:paddingBottom="28dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:textColor="#8A93AE"
                android:textSize="12sp"
                android:text="有哪儿别扭、缺了啥、或者闪退？写两句发给我，能修的我都修～ 昵称和联系方式可以不填，填上我好回复你；图片、视频也可以一起发过来。" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="你的昵称（可不填）"
                android:textColor="#FFC6D5EF"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/nicknameEt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:minHeight="46dp"
                android:singleLine="true"
                android:background="@drawable/field_bg"
                android:padding="12dp"
                android:hint="例如：老张"
                android:textColor="#FFFFFF"
                android:textColorHint="#666680"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="联系方式（可不填，方便回你）"
                android:textColor="#FFC6D5EF"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/contactEt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:minHeight="46dp"
                android:singleLine="true"
                android:inputType="textEmailAddress"
                android:background="@drawable/field_bg"
                android:padding="12dp"
                android:hint="手机号 / QQ / 邮箱都行"
                android:textColor="#FFFFFF"
                android:textColorHint="#666680"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="遇到的问题（写一下现象、怎么操作复现）"
                android:textColor="#FFC6D5EF"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/problemEt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:minLines="5"
                android:gravity="top"
                android:background="@drawable/field_bg"
                android:padding="12dp"
                android:hint="比如：锁屏上倒计时不跳秒了，怎么点都没反应…"
                android:textColor="#FFFFFF"
                android:textColorHint="#666680"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="附上图片 / 视频（可不选）"
                android:textColor="#FFC6D5EF"
                android:textSize="13sp" />

            <Button
                android:id="@+id/addMediaBtn"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="6dp"
                android:text="＋ 添加图片或视频"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#001018"
                android:background="@drawable/circle_btn" />

            <!-- 已选附件：一排小胶囊，点一下就撤掉 -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/attachChips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/attachCountTv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="#8A93AE"
                android:textSize="12sp"
                android:text="" />

            <!-- 上传日志：勾选后随反馈附带一份运行信息，方便我定位 -->
            <LinearLayout
                style="@style/SettingRow"
                android:layout_marginTop="16dp">

                <TextView
                    style="@style/SettingLabel"
                    android:text="附带运行日志" />

                <Switch
                    android:id="@+id/logSwitch"
                    style="@style/GlassSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:id="@+id/logDescTv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:gravity="center"
                android:textColor="#FFC6D5EF"
                android:textSize="12sp"
                android:text="勾选后会把手机型号、系统版本、应用版本和当前倒计时列表一起打包发过来（里面没有你的备注内容）" />

            <!-- 发信方式：想后台直发就填自己的邮箱 + 授权码；不填就走邮箱应用 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="发信方式（选填：填完以后点提交就用你自己的邮箱在后台直接发，不打开邮箱应用；不填就走邮箱应用发）"
                android:textColor="#FFC6D5EF"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/fromEt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:minHeight="46dp"
                android:singleLine="true"
                android:inputType="textEmailAddress"
                android:background="@drawable/field_bg"
                android:padding="12dp"
                android:hint="你的邮箱，例如 123456@qq.com"
                android:textColor="#FFFFFF"
                android:textColorHint="#666680"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/passEt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="46dp"
                android:singleLine="true"
                android:inputType="textVisiblePassword"
                android:background="@drawable/field_bg"
                android:padding="12dp"
                android:hint="邮箱授权码（不是登录密码）"
                android:textColor="#FFFFFF"
                android:textColorHint="#666680"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/smtpStatusTv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:textColor="#8A93AE"
                android:textSize="12sp"
                android:text="" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:textColor="#8A93AE"
                android:textSize="12sp"
                android:text="授权码怎么拿（QQ 邮箱）：打开 QQ 邮箱 → 设置 → 账户 → 往下找到「IMAP / SMTP 服务」打开 → 系统会发给你一个 16 位授权码，把它粘到上面就行（登录密码填这儿发不出去）。" />

            <!-- 填完邮箱 + 授权码先自测一下，别等憋完反馈才发现授权码填错了 -->
            <Button
                android:id="@+id/testBtn"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="10dp"
                android:text="测一下能不能发（用你填的邮箱发一封测试信）"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FFE4EEFF"
                android:background="@drawable/pill_btn_gray" />

            <Button
                android:id="@+id/submitBtn"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:text="提交反馈（直接发到我的邮箱）"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#001018"
                android:background="@drawable/circle_btn" />

            <Button
                android:id="@+id/copyBtn"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="10dp"
                android:text="复制内容备用（手机上没装邮箱时用）"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FFE4EEFF"
                android:background="@drawable/pill_btn_gray" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:lineSpacingExtra="4dp"
                android:textColor="#8A93AE"
                android:textSize="12sp"
                android:text="点「提交反馈」就在后台把信发到 baigao110@qq.com，不跳转邮箱应用，马上提示「反馈已发送，请耐心等待回复！」。\n上面填了「你的邮箱 + 授权码」时，提交会直接走你自己的邮箱发（比默认通道快，也最稳）；没填就用默认通道。\n拿不准配得对不对，就先点「测一下能不能发」：它会往你自己的邮箱发一封测试信，收到了就说明没问题。\n网络不好发不出去时，点「复制内容备用」，粘到微信 / QQ 里发给我也行～" />

        </LinearLayout>
    </ScrollView>

</FrameLayout>
