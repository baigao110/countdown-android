<?xml version="1.0" encoding="utf-8"?>
<!-- 列表条目：底层操作区 + 前景玻璃卡片（液态玻璃风格）。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:layout_marginBottom="10dp"
    android:background="@android:color/transparent">

    <!-- 底层：操作按钮（右对齐，仅露出编辑/删除），前景向左滑动后显示。
         默认 invisible：不滑动时整层不绘制，彻底杜绝半透明前景把它透出来、
         和倒计时文字叠在一起（「按钮被倒计时遮挡」的根因）。左滑时代码里置为 visible。
         （v131 起连卡片按钮行上那一颗提示音名称按钮也一起撤了，换提示音的入口整个去掉） -->
    <LinearLayout
        android:id="@+id/itemActions"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="end|center_vertical"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="invisible"
        android:background="@drawable/glass_card_strong"
        android:paddingStart="14dp"
        android:paddingEnd="10dp">

        <Button
            android:id="@+id/itemEdit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="编辑"
            android:textSize="12sp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:background="@drawable/glass_chip"
            android:padding="6dp" />

        <Button
            android:id="@+id/itemDelete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="删除"
            android:textSize="12sp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:background="@drawable/glass_chip"
            android:padding="6dp"
            android:layout_marginStart="6dp" />
    </LinearLayout>


    <!-- 前景：内容（在上层），可横向滑动露出底层按钮 -->
    <LinearLayout
        android:id="@+id/itemFront"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/glass_card_solid"
        android:elevation="4dp"
        android:clipChildren="false"
        android:padding="12dp">

        <TextView
            android:id="@+id/itemTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/itemSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#D6C6B4" />

        <!-- 实时倒计时：拆成「前缀 / 最后一位数字 / 后缀」三段，
             跳秒动画只作用在中间那一位数字上（颜色与标题一致，风格同悬浮窗） -->
        <LinearLayout
            android:id="@+id/itemTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:clipChildren="false">

            <TextView
                android:id="@+id/itemTimeHead"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="17sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="none"
                android:textColor="#00FFFF" />

            <TextView
                android:id="@+id/itemTimeLast"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="17sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="none"
                android:textColor="#00FFFF" />

            <TextView
                android:id="@+id/itemTimeTail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="17sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="none"
                android:textColor="#00FFFF" />
        </LinearLayout>

        <TextView
            android:id="@+id/itemRemark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#B9A794" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/itemShow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="收起悬浮窗"
                android:textSize="12sp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:background="@drawable/glass_chip"
                android:padding="6dp" />

            <Button
                android:id="@+id/itemMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="显示模式"
                android:textSize="12sp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:background="@drawable/glass_chip"
                android:padding="6dp"
                android:layout_marginStart="6dp" />

            <!-- 当前动画效果：显示名称，点击可循环切换 -->
            <Button
                android:id="@+id/itemAnim"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="无动画"
                android:textSize="12sp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:background="@drawable/glass_chip"
                android:padding="6dp"
                android:layout_marginStart="6dp" />

        </LinearLayout>
    </LinearLayout>

    <!-- v122：勾选框必须排在 itemFront 之后 —— 它 34dp 见方钉在卡片右上角，
         排在前面会被 match_parent + elevation 的前景玻璃卡片整个盖住（v119~v121 三版都只
         透出一层模糊暗影，看着就是「对勾太暗」）。挪到末尾即天然画在最上层。
         ⚠️ v125 补上真正的根因：Android 画一个容器时先画所有 elevation=0 的子视图，
         再把 elevation>0 的「整组」后画 —— 而前景玻璃卡片带着 4dp 抬升、勾选框抬升为 0，
         所以哪怕它写在最后一行，仍然被画在卡片「底下」，只有把卡片左滑挪开才露得全。
         给它 6dp 抬升（高过卡片那 4dp）才稳坐最上层。
         右边那 44dp 沟由 MainActivity.bind() 给卡片内容临时让出来，标题不会被压住。 -->
    <CheckBox
        android:id="@+id/itemCheck"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:elevation="6dp"
        android:button="@drawable/ic_check_circle_selector"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone" />
</FrameLayout>
