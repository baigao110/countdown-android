<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/glass_bg">

    <!-- 液态玻璃背景层：与「关于」页同一套 -->
    <com.baigao.countdown.GlassBackdrop
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

        <!-- 顶部返回栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/backBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="‹ 返回"
                android:textColor="#00FFFF"
                android:textSize="16sp"
                android:padding="4dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="吃药日历"
                android:textColor="#00FFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginEnd="40dp" />
        </LinearLayout>

        <!-- 月份切换 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/prevBtn"
                android:layout_width="56dp"
                android:layout_height="40dp"
                android:text="‹"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#001018"
                android:background="@drawable/circle_btn" />

            <TextView
                android:id="@+id/monthTv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="2026年9月"
                android:textColor="#FFE4EEFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/nextBtn"
                android:layout_width="56dp"
                android:layout_height="40dp"
                android:text="›"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#001018"
                android:background="@drawable/circle_btn" />
        </LinearLayout>

        <!-- 星期表头（周一为第一列） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView style="@style/CalHead" android:text="一" />
            <TextView style="@style/CalHead" android:text="二" />
            <TextView style="@style/CalHead" android:text="三" />
            <TextView style="@style/CalHead" android:text="四" />
            <TextView style="@style/CalHead" android:text="五" />
            <TextView style="@style/CalHead" android:text="六" />
            <TextView style="@style/CalHead" android:text="日" />
        </LinearLayout>

        <!-- 日期格子由 MedicineCalendarActivity 动态生成 -->
        <LinearLayout
            android:id="@+id/gridContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical" />

        <!-- 图例 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● 吃过啦"
                android:textColor="#00FFFF"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="● 还没吃"
                android:textColor="#FF7C86A3"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="○ 今天"
                android:textColor="#7FDBFF"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/timesBtn"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="每天次数"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#001018"
                android:background="@drawable/circle_btn" />

            <Button
                android:id="@+id/doseEditBtn"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:text="编辑吃药时间"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#001018"
                android:background="@drawable/circle_btn" />
        </LinearLayout>

        <TextView
            android:id="@+id/statTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:textColor="#FFEAF6FF"
            android:textSize="13sp"
            android:text="本月吃过 0 天" />

        <Button
            android:id="@+id/todayBtn"
            android:layout_width="220dp"
            android:layout_height="46dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:text="今天已吃药"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#001018"
            android:background="@drawable/circle_btn" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:textColor="#FFA8B3CC"
            android:textSize="12sp"
            android:text="点过去的或今天的日期可以补记 / 撤销，未来的日期不能记哦。\n提醒时间、次数和服药时机可以在「关于」页或上面按钮设置。" />

        <!-- 吃药记录日志：每次吃药的时间（年月日时分秒） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="吃药记录（每次时间）"
                    android:textColor="#00FFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/clearLogBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="清空记录"
                    android:textSize="13sp"
                    android:textColor="#001018"
                    android:background="@drawable/circle_btn" />
            </LinearLayout>

            <Button
                android:id="@+id/addLogBtn"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:text="＋ 记一笔吃药（现在）"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#001018"
                android:background="@drawable/circle_btn" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="10dp"
                android:background="#1AFFFFFF"
                android:padding="8dp">

                <LinearLayout
                    android:id="@+id/logContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <TextView
                android:id="@+id/logEmptyTv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="还没有吃药记录哦～点上面按钮记一笔吧"
                android:textColor="#FFA8B3CC"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    </ScrollView>

</FrameLayout>
