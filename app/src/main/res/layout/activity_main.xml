<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/glass_bg">

    <!-- 液态玻璃背景层：模糊光斑，玻璃卡片透过去才有折射感 -->
    <com.baigao.countdown.GlassBackdrop
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="倒计时"
            android:textColor="#00FFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <ScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/listContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <!-- 拖动排序时承载“跟随手指的幽灵”的覆盖层 -->
    <FrameLayout
        android:id="@+id/dragLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- 扇形弹出菜单（覆盖在最上层，锚定右下角） -->
    <FrameLayout
        android:id="@+id/fabLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 菜单展开时的半透明背景：点击空白处收起 -->
        <View
            android:id="@+id/menuBackdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#59000000"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true" />

        <!-- 菜单项：添加小倒计时（青色玻璃圆钮，扇形排布） -->
        <FrameLayout
            android:id="@+id/menuItemAdd"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:background="@drawable/circle_btn"
            android:clickable="true"
            android:focusable="true"
            android:visibility="invisible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="＋"
                android:textColor="#001018"
                android:textSize="26sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- 菜单项：关于（青色玻璃圆钮，扇形排布） -->
        <FrameLayout
            android:id="@+id/menuItemAbout"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:background="@drawable/circle_btn"
            android:clickable="true"
            android:focusable="true"
            android:visibility="invisible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="?"
                android:textColor="#001018"
                android:textSize="26sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- 菜单项：吃药提醒（青色玻璃圆钮，扇形排布） -->
        <FrameLayout
            android:id="@+id/menuItemMedicine"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:background="@drawable/circle_btn"
            android:clickable="true"
            android:focusable="true"
            android:visibility="invisible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="药"
                android:textColor="#001018"
                android:textSize="24sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- 菜单项：恢复已删除的内置倒计时（青色玻璃圆钮，扇形排布，条件项） -->
        <FrameLayout
            android:id="@+id/menuItemRestore"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:background="@drawable/circle_btn"
            android:clickable="true"
            android:focusable="true"
            android:visibility="invisible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="复"
                android:textColor="#001018"
                android:textSize="24sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- 主按钮：加号（点击扇形弹出菜单，再次点击或点空白收起） -->
        <Button
            android:id="@+id/addBtn"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:text="+"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#001018"
            android:background="@drawable/circle_btn" />
    </FrameLayout>

</FrameLayout>
