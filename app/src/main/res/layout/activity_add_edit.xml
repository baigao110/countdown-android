<?xml version="1.0" encoding="utf-8"?>
<!-- 添加 / 编辑倒计时页：整体风格与「关于」页保持一致
     （深色底 + 顶部青色返回栏 + 青色标题 + 胶囊按钮）。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/glass_bg">

    <com.baigao.countdown.GlassBackdrop
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <!-- 顶部返回栏（与关于页一致） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:id="@+id/backBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="‹ 返回"
            android:textColor="#00FFFF"
            android:textSize="16sp"
            android:padding="4dp" />

        <TextView
            android:id="@+id/pageTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="添加小倒计时"
            android:textColor="#00FFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginEnd="40dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2200FFFF" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingBottom="28dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="名称"
                android:textColor="#00FFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />

            <EditText
                android:id="@+id/etTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="#FFFFFF"
                android:background="@drawable/field_bg"
                android:padding="12dp"
                android:hint="例如：项目截止"
                android:textColorHint="#666680" />

            <TextView
                android:id="@+id/dateLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="目标日期"
                android:textColor="#00FFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/field_bg"
                android:padding="4dp">

                <DatePicker
                    android:id="@+id/datePicker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:calendarViewShown="false"
                    android:spinnersShown="true" />
            </LinearLayout>

            <TextView
                android:id="@+id/timeLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="目标时间"
                android:textColor="#00FFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/field_bg"
                android:padding="4dp">

                <TimePicker
                    android:id="@+id/timePicker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:timePickerMode="spinner" />
            </LinearLayout>


            <!-- v135：「倒计时类型」下拉框 —— 挑一个就按它生成这条倒计时（普通倒计时 / 24小时 / 每小时 …）；
                 下面那排「时 / 分 / 秒」只有挑到「24小时倒计时」时才亮，决定它每天归零的时刻。
                 三颗下拉框用的还是页面上那几颗下拉框同一套样式（GlassSpinner + spinner_dropdown_item）。 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="倒计时类型"
                android:textColor="#00FFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

            <Spinner
                android:id="@+id/builtInSpinner"
                style="@style/GlassSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp" />

            <!-- v163：「是否循环」下拉框 —— 挑「是」这条倒计时归零之后自动重新起一轮（照自己
                 这一轮的时长一轮轮往下转），挑「否」归零就停在 0。
                 跟页面上其它下拉框同一套 GlassSpinner 样式。 -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="是否循环"
                android:textColor="#00FFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

            <Spinner
                android:id="@+id/loopSpinner"
                style="@style/GlassSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp" />

            <!-- v162：「内置档位」这一级整个收掉了（v161 加的 builtInKindLabel / builtInKindSpinner
                 一并删掉），内置这一档由这条自己原来的类型定。 -->

            <!-- v143：「倒计时类型」挑到「100年内倒计时」才亮出来的一整块 ——
                 六颗下拉框（年 / 月 / 日 / 时 / 分 / 秒，跟页面上其它下拉框同一套 GlassSpinner 样式，
                 一行六等分）定下这条倒计时挑的那个时刻；挑其它类型时整块收着。 -->
            <LinearLayout
                android:id="@+id/timeOfDayBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="目标时刻（100年内倒计时）"
                    android:textColor="#00FFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">

                    <Spinner
                        android:id="@+id/yearSpinner"
                        style="@style/GlassSpinner"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="3dp" />

                    <Spinner
                        android:id="@+id/monthSpinner"
                        style="@style/GlassSpinner"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="3dp"
                        android:layout_marginEnd="3dp" />

                    <Spinner
                        android:id="@+id/daySpinner"
                        style="@style/GlassSpinner"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="3dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">

                    <Spinner
                        android:id="@+id/hourSpinner"
                        style="@style/GlassSpinner"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="3dp" />

                    <Spinner
                        android:id="@+id/minuteSpinner"
                        style="@style/GlassSpinner"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="3dp"
                        android:layout_marginEnd="3dp" />

                    <Spinner
                        android:id="@+id/secondSpinner"
                        style="@style/GlassSpinner"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="3dp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="主题颜色"
                android:textColor="#00FFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

            <Spinner
                android:id="@+id/colorSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:minHeight="46dp"
                android:background="@drawable/field_bg"
                android:popupBackground="#1B2138"
                android:paddingStart="12dp"
                android:paddingEnd="8dp" />

            <TextView
                android:id="@+id/standardModeLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="标准模式"
                android:textColor="#00FFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

            <Spinner
                android:id="@+id/standardSpinner"
                style="@style/GlassSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/standardModeHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="选好之后这个倒计时的显示方式就定啦，以后随时能回来改，没有次数限制"
                android:textColor="#FFA8B3CC"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="动画效果"
                android:textColor="#00FFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

            <Spinner
                android:id="@+id/animSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:minHeight="46dp"
                android:background="@drawable/field_bg"
                android:popupBackground="#1B2138"
                android:paddingStart="12dp"
                android:paddingEnd="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="备注"
                android:textColor="#00FFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

            <EditText
                android:id="@+id/etRemark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:minLines="2"
                android:textColor="#FFFFFF"
                android:background="@drawable/field_bg"
                android:padding="12dp"
                android:gravity="top" />

            <!-- v135：只有倒计时类型挑了「24小时倒计时」时，才在下面亮出这一行开关；
                 勾上「启用自定义提示音」，才接着摆出「提示音」那两颗按钮（跟普通倒计时的
                 那两颗一模一样，点一下同样唤起系统铃声选择器）；不勾就整块都收着。 -->

            <!-- v132 / v143 / v158：提示音这一整块默认 gone，只有「倒计时类型」挑到
                 「100年内倒计时」时才亮出来，里面那颗「启用自定义提示音」开关勾上后
                 下面「提示音」那两颗按钮才摆出来（跟其它自定义提示音按钮一模一样），
                 不勾就整块收着、归零只响默认提示音。普通倒计时、华都云境悦府、GTA6 这
                 几档（新建页和编辑页都一样）原本就能挑提示音，v158 起那两颗按钮直接摆着，
                 不再要人先勾开关。内置周期倒计时（每分钟 / 每5分钟 / 每10分钟 / 每半小时 /
                 每小时 / 当日 / 每周 / 当月 …）归零照旧响默认提示音，界面上一块都不摆。 -->
            <LinearLayout
                android:id="@+id/soundToggleBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/soundToggleRow"
                    style="@style/SettingRow"
                    android:layout_marginTop="16dp">

                    <TextView
                        style="@style/SettingLabel"
                        android:text="启用自定义提示音" />

                    <Switch
                        android:id="@+id/soundToggle"
                        style="@style/GlassSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/soundBlock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="提示音"
                    android:textColor="#00FFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp" />

                <Button
                    android:id="@+id/btnSound"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:text="用默认提示音（点一下选一个）"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#001018"
                    android:background="@drawable/pill_btn" />

                <Button
                    android:id="@+id/btnClearSound"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:text="清除自定义提示音"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FF8888"
                    android:background="@drawable/pill_btn_gray" />
            </LinearLayout>
            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSave"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="存好啦"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#001018"
                    android:background="@drawable/pill_btn" />

                <Button
                    android:id="@+id/btnCancel"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="先不了"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#CCCCCC"
                    android:background="@drawable/pill_btn_gray" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    </LinearLayout>

</FrameLayout>
