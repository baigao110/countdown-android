<?xml version="1.0" encoding="utf-8"?>
<!-- 添加 / 编辑倒计时页：整体风格与「关于」页保持一致
     （深色底 + 顶部青色返回栏 + 青色标题 + 胶囊按钮）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F0F19">

    <!-- 顶部返回栏（与关于页一致） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:id="@+id/backBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="‹ 返回"
            android:textColor="#00FFFF"
            android:textSize="16sp"
            android:padding="4dp" />

        <TextView
            android:id="@+id/pageTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="添加倒计时"
            android:textColor="#00FFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginEnd="40dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2200FFFF" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingBottom="28dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="名称"
                android:textColor="#00FFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />

            <EditText
                android:id="@+id/etTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="#FFFFFF"
                android:background="@drawable/field_bg"
                android:padding="12dp"
                android:hint="例如：项目截止"
                android:textColorHint="#666680" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="目标日期"
                android:textColor="#00FFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/field_bg"
                android:padding="4dp">

                <DatePicker
                    android:id="@+id/datePicker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:calendarViewShown="false"
                    android:spinnersShown="true" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="目标时间"
                android:textColor="#00FFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/field_bg"
                android:padding="4dp">

                <TimePicker
                    android:id="@+id/timePicker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:timePickerMode="spinner" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="主题颜色"
                android:textColor="#00FFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

            <Spinner
                android:id="@+id/colorSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:minHeight="46dp"
                android:background="@drawable/field_bg"
                android:popupBackground="#1C1C2E"
                android:paddingStart="12dp"
                android:paddingEnd="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="显示模式"
                android:textColor="#00FFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

            <Spinner
                android:id="@+id/modeSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:minHeight="46dp"
                android:background="@drawable/field_bg"
                android:popupBackground="#1C1C2E"
                android:paddingStart="12dp"
                android:paddingEnd="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="动画效果"
                android:textColor="#00FFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

            <Spinner
                android:id="@+id/animSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:minHeight="46dp"
                android:background="@drawable/field_bg"
                android:popupBackground="#1C1C2E"
                android:paddingStart="12dp"
                android:paddingEnd="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="备注"
                android:textColor="#00FFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

            <EditText
                android:id="@+id/etRemark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:minLines="2"
                android:textColor="#FFFFFF"
                android:background="@drawable/field_bg"
                android:padding="12dp"
                android:gravity="top" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="提示音"
                android:textColor="#00FFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

            <Button
                android:id="@+id/btnSound"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:text="使用默认提示音（点击选择）"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#001018"
                android:background="@drawable/pill_btn" />

            <Button
                android:id="@+id/btnClearSound"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="清除自定义提示音"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FF8888"
                android:background="@drawable/pill_btn_gray" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSave"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="保存"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#001018"
                    android:background="@drawable/pill_btn" />

                <Button
                    android:id="@+id/btnCancel"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="取消"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#CCCCCC"
                    android:background="@drawable/pill_btn_gray" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
