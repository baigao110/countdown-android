<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 液态玻璃：深色渐变底 + 模糊光斑背景层，界面元素统一为半透明玻璃卡片。 -->
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorBackground">#0B1020</item>
        <item name="android:windowBackground">@drawable/glass_bg</item>
        <item name="android:statusBarColor">#0B1020</item>
        <item name="android:navigationBarColor">#0B1020</item>
    </style>

    <!-- 吃药日历：星期表头（七列等宽、居中、灰蓝字） -->
    <style name="CalHead">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#8A93AE</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>
