<?xml version="1.0" encoding="utf-8"?>
<!-- 青色胶囊按钮（主操作）。与「关于」页按钮同色，只是做成等宽圆角以便通栏显示。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="@color/glass_accent_sheen"
        android:centerColor="@color/glass_accent"
        android:endColor="@color/glass_accent_deep"
        android:centerY="0.42" />
    <stroke
        android:width="1dp"
        android:color="@color/glass_highlight" />
    <corners android:radius="26dp" />
</shape>
