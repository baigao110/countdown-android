<?xml version="1.0" encoding="utf-8"?>
<!-- 青色玻璃圆形按钮（主操作）：顶部高光 + 青色主体 + 亮边。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:angle="270"
        android:startColor="@color/glass_accent_sheen"
        android:centerColor="@color/glass_accent"
        android:endColor="@color/glass_accent_deep"
        android:centerY="0.42" />
    <stroke
        android:width="1dp"
        android:color="@color/glass_highlight" />
</shape>
