<?xml version="1.0" encoding="utf-8"?>
<!-- 左右滑动开关的轨道：与主题一致的青色玻璃风格。
     开启 = 青色渐变 + 高光描边；关闭 = 半透明灰（玻璃软描边）。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="@color/glass_accent"
                android:endColor="@color/glass_accent_deep" />
            <corners android:radius="15dp" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_highlight" />
            <size
                android:width="48dp"
                android:height="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#33FFFFFF" />
            <corners android:radius="15dp" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_stroke_soft" />
            <size
                android:width="48dp"
                android:height="28dp" />
        </shape>
    </item>
</selector>
