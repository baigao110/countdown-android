<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 悬浮窗（显示在其他应用上层） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 关于页检查更新（拉取远程版本信息） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 前台服务：后台保活悬浮倒计时 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 通知（归零提示 / 服务常驻） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 吃药提醒：允许通知在息屏 / 锁屏时直接弹出（Android 14+ 需显式声明） -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- 提醒震动 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 后台检查更新：忽略电池优化，避免系统掐断后台网络 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 每日吃药提醒：到点准时弹通知（精确闹钟；拿不到权限时自动退化为重复闹钟） -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- 开机自启悬浮倒计时 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 应用内更新：下载 APK 后拉起系统安装界面（Android 8.0+ 需要该权限） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AddEditActivity"
            android:exported="false" />

        <activity
            android:name=".UpdateActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/UpdateTransparent" />

        <activity
            android:name=".AboutActivity"
            android:exported="false" />

        <!-- 吃药提醒的全屏意图会拉起本页：允许在锁屏上显示并点亮屏幕 -->
        <activity
            android:name=".MedicineCalendarActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <!-- 悬浮倒计时前台服务：specialUse 子类型说明必须作为 <service> 的子元素，
             否则 Android 14 调用 startForegroundService 会抛 MissingForegroundServiceTypeException 导致崩溃 -->
        <service
            android:name=".CountdownService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="countdown overlay floating window" />
        </service>

        <!-- 应用内更新：以 content:// 方式把已下载的 APK 交给系统安装器 -->
        <provider
            android:name=".ApkProvider"
            android:authorities="${applicationId}.apkprovider"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- 恢复后台任务的时机越多，通知断掉的机会越少：
             开机 / 覆盖安装（升级后闹钟会被系统清掉，必须重挂）/ 解锁 /
             用户改时间 / 改时区 / 跨天 —— 这些都是闹钟与巡检会失效的时刻。
             directBootAware 让它在「未解锁」阶段也能收到广播（此时不读偏好设置）。 -->
        <receiver
            android:name=".BootReceiver"
            android:directBootAware="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.USER_PRESENT" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- 后台定期检查更新（AlarmManager 唤起，发现新版本发系统通知） -->
        <!-- 每日吃药提醒：到点发通知，通知上的「已吃药」也走这里 -->
        <receiver
            android:name=".MedicineAlarmReceiver"
            android:exported="false" />

        <!-- 倒计时归零常驻通知的「停止」按钮 -->
        <receiver
            android:name=".CountdownFinishReceiver"
            android:exported="false" />

        <receiver
            android:name=".UpdateCheckReceiver"
            android:exported="false" />

        <!-- 后台定期检查更新（JobScheduler：有网络才跑、重启后自动恢复） -->
        <service
            android:name=".UpdateCheckJobService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="true" />

        <!-- 吃药提醒：后台巡检（闹钟被系统清掉时补挂、错过时补发通知） -->
        <service
            android:name=".MedicineCheckJobService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="true" />

    </application>

</manifest>
