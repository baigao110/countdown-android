<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 悬浮窗（显示在其他应用上层） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 关于页检查更新（拉取远程版本信息） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 前台服务：后台保活悬浮倒计时 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 通知（归零提示 / 服务常驻） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 后台检查更新：忽略电池优化，避免系统掐断后台网络 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 开机自启悬浮倒计时 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 应用内更新：下载 APK 后拉起系统安装界面（Android 8.0+ 需要该权限） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AddEditActivity"
            android:exported="false" />

        <activity
            android:name=".AboutActivity"
            android:exported="false" />

        <!-- 悬浮倒计时前台服务：specialUse 子类型说明必须作为 <service> 的子元素，
             否则 Android 14 调用 startForegroundService 会抛 MissingForegroundServiceTypeException 导致崩溃 -->
        <service
            android:name=".CountdownService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="countdown overlay floating window" />
        </service>

        <!-- 应用内更新：以 content:// 方式把已下载的 APK 交给系统安装器 -->
        <provider
            android:name=".ApkProvider"
            android:authorities="${applicationId}.apkprovider"
            android:exported="false"
            android:grantUriPermissions="true" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 后台定期检查更新（AlarmManager 唤起，发现新版本发系统通知） -->
        <receiver
            android:name=".UpdateCheckReceiver"
            android:exported="false" />

        <!-- 后台定期检查更新（JobScheduler：有网络才跑、重启后自动恢复） -->
        <service
            android:name=".UpdateCheckJobService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="true" />

    </application>

</manifest>
