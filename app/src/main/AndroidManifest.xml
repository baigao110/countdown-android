<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 悬浮窗（显示在其他应用上层） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 关于页检查更新（拉取远程版本信息） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 前台服务：后台保活悬浮倒计时 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 通知（归零提示 / 服务常驻） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 吃药提醒：允许通知在息屏 / 锁屏时直接弹出（Android 14+ 需显式声明） -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- 提醒震动 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 后台检查更新：忽略电池优化，避免系统掐断后台网络 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 每日吃药提醒：到点准时弹通知（精确闹钟；拿不到权限时自动退化为重复闹钟） -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- 开机自启悬浮倒计时 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 应用内更新：下载 APK 后拉起系统安装界面（Android 8.0+ 需要该权限） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 反馈页的 SMTP 走 587 那档时，开头那几步是明文的；Android 9 起默认拦明文连接，
         不加这条会实实在在连不上服务器（表现为「点了半天没动静」）。465 那档不受影响。 -->
    <application
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AddEditActivity"
            android:exported="false" />

        <activity
            android:name=".UpdateActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/UpdateTransparent" />

        <activity
            android:name=".AboutActivity"
            android:exported="false" />

        <!-- 吃药提醒设置页：从主界面「+」号菜单的「吃药提醒」进入 -->
        <activity
            android:name=".MedicineReminderActivity"
            android:exported="false" />

        <!-- 吃药提醒的全屏意图会拉起本页：允许在锁屏上显示并点亮屏幕 -->
        <activity
            android:name=".MedicineCalendarActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <!-- 锁屏通知常亮页：挂在锁屏之上的全透明页，只为按住屏幕（FLAG_KEEP_SCREEN_ON 只认 Activity）。
             独占一个任务、不进最近任务；不抢焦点、不拦触摸，锁屏照常能划能点。 -->
        <activity
            android:name=".LockKeepActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity="com.baigao.countdown.lockkeep"
            android:showWhenLocked="true"
            android:theme="@style/LockKeepTheme" />

        <!-- 意见反馈页：从「关于」页的「意见反馈」按钮进入（昵称 / 联系方式可不填，能带图片视频与日志） -->
        <activity
            android:name=".FeedbackActivity"
            android:exported="false" />

        <!-- 悬浮倒计时前台服务：specialUse 子类型说明必须作为 <service> 的子元素，
             否则 Android 14 调用 startForegroundService 会抛 MissingForegroundServiceTypeException 导致崩溃 -->
        <service
            android:name=".CountdownService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="countdown overlay floating window" />
        </service>

        <!-- 意见反馈的附件共享器：把缓存目录里的图片 / 视频 / 日志以 content:// 交给邮箱客户端读取，
             applied 时用 FLAG_GRANT_READ_URI_PERMISSION 授权，不往公共存储里塞文件、不需要存储权限 -->
        <provider
            android:name=".FeedbackProvider"
            android:authorities="${applicationId}.feedback"
            android:exported="true"
            android:grantUriPermissions="true" />

        <!-- 应用内更新：以 content:// 方式把已下载的 APK 交给系统安装器 -->
        <provider
            android:name=".ApkProvider"
            android:authorities="${applicationId}.apkprovider"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- 恢复后台任务的时机越多，通知断掉的机会越少：
             开机 / 覆盖安装（升级后闹钟会被系统清掉，必须重挂）/ 解锁 /
             用户改时间 / 改时区 / 跨天 —— 这些都是闹钟与巡检会失效的时刻。
             directBootAware 让它在「未解锁」阶段也能收到广播（此时不读偏好设置）。 -->
        <receiver
            android:name=".BootReceiver"
            android:directBootAware="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.USER_PRESENT" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- 后台定期检查更新（AlarmManager 唤起，发现新版本发系统通知） -->
        <!-- 每日吃药提醒：到点发通知，通知上的「已吃药」也走这里 -->
        <receiver
            android:name=".MedicineAlarmReceiver"
            android:exported="false" />

        <!-- 倒计时归零常驻通知的「停止」按钮 -->
        <receiver
            android:name=".CountdownFinishReceiver"
            android:exported="false" />

        <!-- 锁屏倒计时「唤醒刷新」：息屏 / Doze 把前台服务冻住时，靠这个闹钟把锁屏通知刷成最新；
             顺带监听屏幕点亮 / 熄灭 / 解锁：「锁屏通知常亮」要在屏幕一点亮的瞬间就把常亮页挂上去 -->
        <receiver
            android:name=".LockScreenRefreshReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.SCREEN_ON" />
                <action android:name="android.intent.action.SCREEN_OFF" />
                <action android:name="android.intent.action.USER_PRESENT" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".UpdateCheckReceiver"
            android:exported="false" />

        <!-- 后台定期检查更新（JobScheduler：有网络才跑、重启后自动恢复） -->
        <service
            android:name=".UpdateCheckJobService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="true" />

        <!-- 吃药提醒：后台巡检（闹钟被系统清掉时补挂、错过时补发通知） -->
        <service
            android:name=".MedicineCheckJobService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="true" />

    </application>

</manifest>
